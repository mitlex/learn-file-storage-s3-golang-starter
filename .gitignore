# --- Go Binaries & Outputs ---
# Compiled executable binaries for Windows (main target and backups)
*.exe
*.exe~
# Compiled library binaries for Windows, Linux, and macOS
*.dll
*.so
*.dylib
# Standard output folder where compiled binaries are often saved
bin/
# The specific compiled binary for this project (matches directory name)
learn-file-storage-s3-golang-starter

# --- Go Testing & Performance Profiles ---
# Code coverage profiles generated by 'go test -coverprofile'
*.out
*.coverprofile
# Performance profiling data (CPU, memory) from 'go tool pprof'
*.pprof

# --- Go Dependencies & Workspaces ---
# Local multi-module workspace files (never commit these to source control)
go.work
go.work.sum
# Local vendor directory (only used if caching modules locally via 'go mod vendor')
vendor/

# --- WSL / Windows / macOS Metadata ---
# macOS system file containing folder view preferences
.DS_Store         
# Windows system file containing thumbnail images for folders     
Thumbs.db          
# Windows system file for folder icon and display settings    
desktop.ini        
# Windows recycle bin data if working on an external drive     
$RECYCLE.BIN/          

# --- IDEs & Editors ---
# Your personal VS Code settings (theme, window size, local paths) 
.vscode/            
# JetBrains (GoLand) project settings    
.idea/             
# "Swap" files: Temporary recovery files created by Vim/Unix editors    
*.swp                
# "Swap" files: Similar to .swp; created when editing the same file twice   
*.swo                 
# REST Client for Visual Studio Code - this file contains HTTP requests for testing
test.http

# --- Local Environment Secrets ---
# DANGER: NEVER commit this. Contains API keys and private credentials 
.env

# Application runtime logs or crash dumps
*.log
*.crash

# Other items provided in original .gitignore file provided with the bootdev learn-file-storage-s3-golang-starter repo that I forked
#   Note: .env was in this list below but I already have it above - hence removal of duplicate 
out
*.db
assets/
samples/